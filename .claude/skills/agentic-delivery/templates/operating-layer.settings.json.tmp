{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/agentic-delivery/scripts/pipe_mask_guard.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOUSE_DEFAULTS_FILE=.claude/house-defaults.md python3 .claude/skills/agentic-delivery/scripts/subagent_start_inject.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/agentic-delivery/scripts/handback_cap.py"
          }
        ]
      },
      {
        "matcher": "<your-read-only-review-type>",
        "hooks": [
          {
            "type": "command",
            "command": "HANDBACK_MAX_LINES=25 HANDBACK_MAX_CHARS=2000 python3 .claude/skills/agentic-delivery/scripts/handback_cap.py"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.npm"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Edit(/**)",
      "Bash(python3 -m pytest *)",
      "Bash(pytest *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(pnpm test *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(sudo *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  }
}
